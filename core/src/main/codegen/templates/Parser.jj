|   < WEEKS: "WEEKS" >
|   < WHEN: "WHEN" >
|   < WHENEVER: "WHENEVER" >
|   < WHERE: "WHERE" >
|   < WIDTH_BUCKET: "WIDTH_BUCKET" >
|   < WINDOW: "WINDOW" >
|   < WITH: "WITH" >
|   < WITHIN: "WITHIN" >
|   < WITHOUT: "WITHOUT" >
|   < WORK: "WORK" >
|   < WRAPPER: "WRAPPER" >
|   < WRITE: "WRITE" >
|   < XML: "XML" >
|   < YEAR: "YEAR" >
|   < YEARS: "YEARS" >
|   < ZONE: "ZONE" >
<#-- additional parser keywords are included here -->
<#list (parser.keywords!default.parser.keywords) as keyword>
|   < ${keyword}: "${keyword}" >
</#list>
}

/**
 * Parses a non-reserved keyword for use as an identifier.
 *
 * <p>The method is broken up into several sub-methods; without this
 * decomposition, parsers such as Babel with more than ~1,000 non-reserved
 * keywords would generate such deeply nested 'if' statements that javac would
 * fail with a {@link StackOverflowError}.
 *
 * <p>The list is generated from the FMPP config data. To add or remove
 * keywords, modify config.fmpp. For parsers except Babel, make sure that
 * keywords are not reserved by the SQL standard.
 *
 * @see Glossary#SQL2003 SQL:2003 Part 2 Section 5.2
 */
String NonReservedKeyWord() :
{
}
{
    (
        NonReservedKeyWord0of3()
    |   NonReservedKeyWord1of3()
    |   NonReservedKeyWord2of3()
    )
    {
        return unquotedIdentifier();
    }
}

/** @see #NonReservedKeyWord */
void NonReservedKeyWord0of3() :
{
}
{
    (
<#list (parser.nonReservedKeywords!default.parser.nonReservedKeywords) + (parser.nonReservedKeywordsToAdd!default.parser.nonReservedKeywordsToAdd) as keyword>
<#if keyword?index == 0>
        <${keyword}>
<#elseif keyword?index % 3 == 0>
    |   <${keyword}>
</#if>
</#list>
    )
}

/** @see #NonReservedKeyWord */
void NonReservedKeyWord1of3() :
{
}
{
    (
<#list (parser.nonReservedKeywords!default.parser.nonReservedKeywords) + (parser.nonReservedKeywordsToAdd!default.parser.nonReservedKeywordsToAdd) as keyword>
<#if keyword?index == 1>
        <${keyword}>
<#elseif keyword?index % 3 == 1>
    |   <${keyword}>
</#if>
</#list>
    )
}

/** @see #NonReservedKeyWord */
void NonReservedKeyWord2of3() :
{
}
{
    (
<#list (parser.nonReservedKeywords!default.parser.nonReservedKeywords) + (parser.nonReservedKeywordsToAdd!default.parser.nonReservedKeywordsToAdd) as keyword>
<#if keyword?index == 2>
        <${keyword}>
<#elseif keyword?index % 3 == 2>
    |   <${keyword}>
</#if>
</#list>
    )
}

/* LITERALS */
// 定义了 Calcite 解析器中关于数值字面量（Numeric Literals）和二进制字符串（Binary Strings）的词法规则。
<DEFAULT, DQID, BTID, BQID, BQHID> TOKEN :
{
    // 整数
    // 最基础的规则，匹配一个或多个 0-9 的数字。
    < UNSIGNED_INTEGER_LITERAL: (["0"-"9"])+ >
|
    // 近似数值（科学计数法）
    // 由一个整数或小数，后面紧跟一个指数部分（EXPONENT）
    // 示例：1.2E10, 10e-5, .5E+2。
    < APPROX_NUMERIC_LITERAL:
    (<UNSIGNED_INTEGER_LITERAL> | <DECIMAL_NUMERIC_LITERAL>) <EXPONENT> >
|
    // 小数
    // 使用了 “或” (|) 逻辑来覆盖两种写小数的习惯：
    // 左侧：数字开头，点可选，后面可以跟数字（如 12. 或 12.34）。
    // 右侧：直接以点开头，后面必须跟数字（如 .5）。
    < DECIMAL_NUMERIC_LITERAL:
    (["0"-"9"])+(".")?(["0"-"9"])*
    | "."(["0"-"9"])+
    >
|
    // 这些规则不会生成独立的 Token，仅供内部嵌套使用：
    // 定义科学计数法的尾部
    // 匹配 e 或 E，可选的正负号 +/-，以及至少一个数字。
    < #EXPONENT: ["e","E"] (["+","-"])? (["0"-"9"])+ >
|
    // 定义十六进制字符。
    < #HEXDIGIT: ["0"-"9","a"-"f","A"-"F"] >
|
    // 定义空白符。
    // 包含空格、制表符、换行、回车、换页符。
    < #WHITESPACE:
    [ " ","\t","\n","\r","\f" ]
    >
|
    /* To improve error reporting, we allow all kinds of characters,
     * not just hexits, in a binary string literal. */
     // 二进制字符串
     // 通常表现为 x'FFAA' 或 X'0011'。
    < BINARY_STRING_LITERAL: ["x","X"] <QUOTE> ( (~["'"]) | ("''"))* <QUOTE> >
}

// All databases except BigQuery support standard single-quoted literals,
// which use single-quote as the escape character.
// 核心的字符串字面量（String Literals）解析规则
// 在 SQL 中，字符串的处理远比想象中复杂，因为不同的数据库对编码、前缀和转义字符的支持各不相同。这段代码通过不同的 Token 定义，一次性解决了标准 SQL、PostgreSQL 风格和国际化字符集的问题。
<DEFAULT, DQID, BTID> TOKEN :
{
    // 标准字符串
    // 最基础的单引号字符串。
    // 转义：使用 SQL 标准的双单引号 '' 来表示字符串内部的一个单引号。
    // 示例：'Hello World', 'It''s a sunny day'。
    < QUOTED_STRING: <QUOTE> ( (~["'"]) | ("''"))* <QUOTE> >
|
    // 带字符集前缀的字符串
    // _charset：例如 _UTF8'中文' 或 _LATIN1'string'。
    // N：SQL 标准中表示 National Character Set（通常是 Unicode）的前缀，如 N'National String'。
    < PREFIXED_STRING_LITERAL: ("_" <CHARSETNAME> | "N") <QUOTED_STRING> >
|
    //定义 Unicode 字符串字面量
    < UNICODE_STRING_LITERAL: "U" "&" <QUOTED_STRING> >
|
    // C 语言风格转义
    // 背景：这是 PostgreSQL 非常经典的语法。
    // 前缀为 E，支持反斜杠 \ 作为转义符。
    // 示例：E'Line 1\nLine 2'。
    < C_STYLE_ESCAPED_STRING_LITERAL: "E" <QUOTE> ( (~["'", "\\"]) | ("\\" ~[]) | "''")* <QUOTE> >
|
    < #CHARSETNAME: (["a"-"z","A"-"Z","0"-"9"])
    (["a"-"z","A"-"Z","0"-"9",":",".","-","_"])*  //定义字符集名称的规则。字符集名称通常由字母、数字、冒号、点、连字符和下划线组成。
    >
}

// BigQuery supports single- and double-quoted literals with back-slash
// as the escape character.
// 这段规则被限定在 <BQID, BQHID> 状态下，核心变化在于它将反斜杠 (\) 视为通用的转义符，并且同时支持双引号和单引号定义的字符串。
<BQID, BQHID> TOKEN :
{
    // BigQuery-style double-quoted string, escaped using backslash
    // 双引号字符串
    // 边界：由 " (Double Quote) 包围。
    < BIG_QUERY_DOUBLE_QUOTED_STRING:
    // 匹配任何不是反斜杠且不是双引号的字符。
    // 如果遇到反斜杠，则将其与紧随其后的任何字符（~[]）一起抓取，将其视为一个转义整体。
    // 示例："Hello \"World\""。在标准 SQL 中这会报错（标准 SQL 标识符才用双引号，且转义通常用 ""），但在 BigQuery 模式下，这是一个合法的字符串。
      <DOUBLE_QUOTE> ( (~["\\", "\""]) | ("\\" ~[]) )* <DOUBLE_QUOTE>
    >
|
    // BigQuery-style single-quoted string, escaped using backslash
    // 单引号字符串
    // 边界：由 ' (Single Quote) 包围。
    // 逻辑：与双引号版本一致，只是边界和排除字符换成了单引号。
    // 示例：'It\'s a cat'。
    < BIG_QUERY_QUOTED_STRING:
      <QUOTE> ( (~["\\", "'"]) | ("\\" ~[]) )* <QUOTE>
    >
}

// 在 SQL 标准中，如果你不希望使用默认的反斜杠 \ 作为 Unicode 转义符，可以通过 UESCAPE 子句指定一个自定义的字符。
// 定义了哪些字符可以合法地作为自定义转义符。
<DEFAULT, DQID, BTID, BQID, BQHID> TOKEN :
{
    < UNICODE_QUOTED_ESCAPE_CHAR:
    <QUOTE> // 1. 起始单引号 '
    // // 2. 排除列表：不能作为转义符的字符
    (~["0"-"9","a"-"f","A"-"F","+","\""," ","\t","\n","\r","\f"])
    <QUOTE> // 3. 结束单引号 '
    >
}

/* SEPARATORS */
// 义了 Calcite 解析器中的 分隔符（Separators）。这些符号是 SQL 语法的“骨架”，用于划定表达式边界、调用函数、组织列表以及支持特定的 SQL 扩展语法。
<DEFAULT, DQID, BTID, BQID, BQHID> TOKEN :
{
 // ( 和 )。用于函数调用、子查询、优先级控制以及定义 IN 列表。
    < LPAREN: "(">
|   < RPAREN: ")">
// 使用了 FreeMarker 模板语法 (<#if ...>)，说明这部分是可配置的。大括号 {} 在 SQL 中通常用于 JDBC 转义语法，允许数据库执行特定于厂商或标准的函数和字面量。
<#if (parser.includeBraces!default.parser.includeBraces) >
|   < LBRACE_D: "{" (" ")* ["d","D"] > // 日期字面量 {d '2023-10-27'}
|   < LBRACE_T: "{" (" ")* ["t","T"] > // 时间字面量 {t '14:30:00'}
|   < LBRACE_TS: "{" (" ")* ["t","T"] ["s","S"] > // 时间戳字面量 {ts '2023-10-27 14:30:00'}
|   < LBRACE_FN: "{" (" ")* ["f","F"] ["n","N"] > // 标量函数调用 {fn ABS(-1)}
|   < LBRACE: "{" > // 普通左大括号
|   < RBRACE: "}" >
<#else>
<#include "/@includes/braces.ftl" />
</#if>
// [ 和 ]。在标准 SQL 中常用于数组索引访问。
|   < LBRACKET: "[" >
|   < RBRACKET: "]" >
// ;。SQL 语句的结束标志。
|   < SEMICOLON: ";" >
// .。用于对象引用（如 schema.table.column）。
|   < DOT: "." >
// ,。用于分隔列表项（如 SELECT a, b, c）。
|   < COMMA: "," >
}

/* OPERATORS */

<DEFAULT, DQID, BTID, BQID, BQHID> TOKEN :
{
    < EQ: "=" >
|   < GT: ">" >
|   < LT: "<" >
|   < HOOK: "?" >
|   < COLON: ":" >
|   < LE: "<=" >
|   < GE: ">=" >
|   < NE: "<>" >
|   < NE2: "!=" >
|   < PLUS: "+" >
|   < MINUS: "-" >
|   < LAMBDA: "->" >
|   < STAR: "*" >
|   < SLASH: "/" >
|   < PERCENT_REMAINDER: "%" >
|   < CONCAT: "||" >
|   < NAMED_ARGUMENT_ASSIGNMENT: "=>" >
|   < DOUBLE_PERIOD: ".." >
|   < QUOTE: "'" >
|   < DOUBLE_QUOTE: "\"" >
|   < VERTICAL_BAR: "|" >
|   < CARET: "^" >
|   < DOLLAR: "$" >
<#list (parser.binaryOperatorsTokens!default.parser.binaryOperatorsTokens) as operator>
|   ${operator}
</#list>
}


/*****************************************
 * Lexical Descriptions                  *
 *****************************************/

TOKEN_MGR_DECLS : {
    final List<Integer> lexicalStateStack = new ArrayList<Integer>();

    void pushState() {
      lexicalStateStack.add(curLexState);
    }

    void popState() {
      SwitchTo(lexicalStateStack.remove(lexicalStateStack.size() - 1));
    }

    void beforeTableName() {
      if (curLexState == BQID) {
        pushState();
        SwitchTo(BQHID);
      }
    }

    void afterTableName() {
      if (curLexState == BQHID) {
        popState();
      }
    }

<#if (parser.includeAdditionalDeclarations!default.parser.includeAdditionalDeclarations)>
  <#include "/@includes/tokenManagerDeclarations.ftl" />
</#if>
}

/*
Lexical states:

DEFAULT: Identifiers are quoted in brackets, e.g. [My Identifier]
DQID:    Identifiers are double-quoted, e.g. "My Identifier"
BTID:    Identifiers are enclosed in back-ticks, escaped using back-ticks,
         e.g. `My ``Quoted`` Identifier`
BQID:    Identifiers are enclosed in back-ticks, escaped using backslash,
         e.g. `My \`Quoted\` Identifier`,
         and with the potential to shift into BQHID in contexts where table
         names are expected, and thus allow hyphen-separated identifiers as
         part of table names
BQHID:   Identifiers are enclosed in back-ticks, escaped using backslash,
         e.g. `My \`Quoted\` Identifier`
         and unquoted identifiers may contain hyphens, e.g. foo-bar
IN_SINGLE_LINE_COMMENT:
IN_FORMAL_COMMENT:
IN_MULTI_LINE_COMMENT:

DEFAULT, DQID, BTID, BQID are the 4 'normal states'. Behavior is identical
except for how quoted identifiers are recognized.

The BQHID state exists only at the start of a table name (e.g. immediately after
FROM or INSERT INTO). As soon as an identifier is seen, the state shifts back
to BTID.

After a comment has completed, the lexer returns to the previous state, one
of the 'normal states'.
*/

/* WHITE SPACE */
// 词法分析器中的 SKIP 规则
// 告诉解析器哪些内容应该被彻底忽略，不作为 Token 处理。
<DEFAULT, DQID, BTID, BQID, BQHID> SKIP :
{
    " " // 空格 (Space)
|   "\t"
|   "\n"
|   "\r"
|   "\f"
}

/* COMMENTS */
// SQL 中 注释（Comments） 相关的特殊边界。
// 在 Calcite 中，注释通常分为“普通注释”和“优化器提示（Hints）”。这段规则的核心在于区分这两种类型，并为解析器处理 SQL Hints 提供触发信号。
<DEFAULT, DQID, BTID, BQID, BQHID> TOKEN :
{
    < HINT_BEG: "/*+"> // 提示开始，匹配以 /*+ 开头的字符串。在 SQL 中，/* ... */ 是普通的多行注释，但如果在左侧紧跟一个 + 号，它就变成了 Optimizer Hint。
|   < COMMENT_END: "*/" > // 注释结束
}
// 定义了一个词法分析器中的 MORE 规则，用于处理 SQL 中的 正式注释（Formal Comments / Javadoc 风格注释）。
// 在 JavaCC 中，MORE 关键字意味着：“目前抓取到的字符还不足以构成一个完整的 Token，请继续往下读，并将这些字符存入缓冲区。”
<DEFAULT, DQID, BTID, BQID, BQHID> MORE :
{
    <"/**" ~["/"]> { pushState(); } : IN_FORMAL_COMMENT // 一旦匹配成功，词法分析器将立即进入 IN_FORMAL_COMMENT 状态。在这个新状态下，解析器会有一套专门的规则来处理注释内部的文本，直到遇到结束符 */。
}
// 词法分析器处理 普通多行注释 (/* ... */) 的入口规则
<DEFAULT, DQID, BTID, BQID, BQHID> MORE :
{
    // "/*": 匹配多行注释的起始符号。
    "/*" { pushState(); } : IN_MULTI_LINE_COMMENT // 将状态切换到专门处理多行注释内容的模式。
}
// 定义了 Calcite 如何处理 单行注释。与多行注释不同，单行注释的处理逻辑非常直接：它被定义在 SKIP 块中，这意味着解析器在识别出整行注释后会直接将其丢弃，不会产生任何 Token 传递给下一阶段。
<DEFAULT, DQID, BTID, BQID, BQHID> SKIP :
{
    <SINGLE_LINE_COMMENT: ("//"|"--")(~["\n","\r"])* ("\n"|"\r"|"\r\n")? >
}
// 定义了词法分析器处于 IN_FORMAL_COMMENT（正式注释内部）状态时，如何结束匹配并返回原有状态。
// SPECIAL_TOKEN，这是一个在 JavaCC 中非常高级且细腻的用法。
// 不同于普通 TOKEN，SPECIAL_TOKEN 会被提取出来，但它不会被传递给语法解析器（Parser）进行逻辑匹配。
// 作用：它像是一个“影子 Token”，会附着在它之后出现的第一个普通 Token 上。
// 目的：这允许 Calcite 保留这些注释内容（例如为了生成文档或保留原始 SQL 结构），但又不会干扰正常的 SQL 语法解析（SQL 语法不包含“注释”这一项）。
<IN_FORMAL_COMMENT>
SPECIAL_TOKEN :
{
   // 它引用了之前定义的 <COMMENT_END>（即 */）。
   // 当在正式注释状态下读到 */ 时，整个注释宣告结束。
   // 执行状态出栈。由于之前进入正式注释时使用了 pushState()，现在的 popState() 会让解析器瞬间回到进入注释前的那个状态（如 DEFAULT 或 BQID）。
    <FORMAL_COMMENT: <COMMENT_END> > { popState(); }
}
// 通过使用 SPECIAL_TOKEN，Calcite 确保了这些注释虽然不参与 SQL 逻辑运算，但其内容可以被保留下来，供后续的工具（如格式化器或文档生成器）使用。
// 在 JavaCC 中，Token 分为三类：TOKEN（参与解析）、SKIP（直接丢弃）和 SPECIAL_TOKEN（保留但不参与解析）。
// 附着机制：SPECIAL_TOKEN 会自动关联到紧随其后的第一个“常规 Token”。
// 示例 SELECT /* 这是一个注释 */ score FROM users;
// 在这个语句中，/* 这是一个注释 */ 会作为 SPECIAL_TOKEN 挂载到 score 这个 IDENTIFIER 节点上。如果你以后通过 Calcite 的 AST 访问 score 节点，你可以找回这段注释。
<IN_MULTI_LINE_COMMENT>
SPECIAL_TOKEN :
{
    <MULTI_LINE_COMMENT: <COMMENT_END> > { popState(); }
}
// 多行注释处理逻辑中的“大胃王”，它负责吞噬注释内部的所有字符。
// ~[] 是一个极具威力的通配符，表示“匹配任何字符”。
// 多状态覆盖：该规则同时在 IN_FORMAL_COMMENT (正式注释) 和 IN_MULTI_LINE_COMMENT (普通多行注释) 两个状态下生效。
// 每当词法分析器读到一个字符，它不会立即将其作为一个独立的 Token 发送出去，而是将其追加到当前的缓冲区（Buffer）中。
<IN_FORMAL_COMMENT,IN_MULTI_LINE_COMMENT>
MORE :
{
    < ~[] >
}


/* IDENTIFIERS */
// 在 DEFAULT 状态下如何解析 方括号标识符（Bracket Quoted Identifier）
// 这种格式主要用于 Microsoft SQL Server 和 Microsoft Access 风格的 SQL 方言中，用来处理包含空格或保留关键字的表名和列名（例如 [Order Details]）
<DEFAULT> TOKEN :
{
    < BRACKET_QUOTED_IDENTIFIER:
    "["  // 1. 匹配起始符：左方括号
    (
        (~["]","\n","\r"]) // 2a. 匹配任何不是右方括号、不是换行、不是回车的字符
    |
        ("]]") // 2b. 匹配两个连续的右方括号（转义情况）
    )+  // 以上内容重复 1 次或多次
    "]"  // 3. 匹配结束符：右方括号
    >
}
// 定义了在 DQID（Double Quoted Identifier）词法状态下如何匹配一个双引号标识符
// <DQID>: 这是一个词法状态标签。它表示这条规则生效的前提是词法分析器当前处于 DQID 状态。
// TOKEN: 定义一个正式的词法单元，名为 QUOTED_IDENTIFIER。
<DQID> TOKEN :
{
    < QUOTED_IDENTIFIER:
    "\""  // 1. 匹配起始的双引号
    (
        (~["\"","\n","\r"])  // 2a. 匹配任何不是双引号、不是换行、不是回车的字符
    |
        ("\"\"") // 2b. 或者匹配两个连续的双引号（转义情况）
    )+  // 以上 2a 或 2b 的组合必须出现 1 次或多次
    "\"" // 3. 匹配结束的双引号
    >
}
// 在 BTID (Back Tick ID) 词法状态下，如何匹配 反引号标识符（Back Quoted Identifier）。
// 主要用于适配 MySQL、MariaDB 以及 Apache Hive 等方言的引用风格。
<BTID> TOKEN :
{
    < BACK_QUOTED_IDENTIFIER:
    "`" // 1. 起始符：反引号 (Backtick)
    (
        (~["`","\n","\r"]) // 2a. 匹配任何不是反引号、不是换行、不是回车的字符
    |
        ("``") // 2b. 匹配两个连续的反引号（转义情况）
    )+  // 以上内容重复 1 次或多次
    "`" // 3. 结束符：反引号
    >
}
// 在 BQID (BigQuery ID) 和 BQHID 词法状态下，如何解析 BigQuery 风格的反引号标识符。
// 它的核心特殊之处在于使用了 反斜杠 (\) 而不是双重符号来处理转义，这与 MySQL 风格有显著区别。
<BQID, BQHID> TOKEN :
{
    // BigQuery-style backtick-quoted identifier, escaped using backslash
    < BIG_QUERY_BACK_QUOTED_IDENTIFIER:
    "`" // 1. 起始符：反引号
    (
        (~["\\", "`"]) // 2a. 匹配任何不是反斜杠且不是反引号的字符
    |
        ("\\" ~[]) // 2b. 匹配反斜杠（\）后面跟着的任意一个字符
    )* // 以上 2a 或 2b 的组合可以重复 0 次或多次
    "`" // 3. 结束符：反引号
    >
}
// 非常特殊的 Token：HYPHENATED_IDENTIFIER（带连字符的标识符）。
// 门用于支持 Google BigQuery 风格的项目 ID（Project ID）。在标准 SQL 中，连字符 - 通常被识别为减法运算符，但在 BigQuery 中，项目 ID（如 my-project-123）可以直接作为标识符使用。
<BQHID> TOKEN :
{
    // Per BigQuery: "Project IDs must contain 6-63 lowercase letters, digits,
    // or dashes. IDs must start with a letter and may not end with a dash."
    // We do not restrict length, or prevent identifiers from ending in a dash.
    // <LETTER>: 必须以字母开头。这符合代码注释中提到的“IDs must start with a letter”。
    // (<LETTER>|<DIGIT>|"-")*: 后续可以是字母、数字或连字符 -，且可以重复任意次数。
    // { popState(); }: 这是一个词法动作（Lexical Action）。
    // 作用：当匹配到这个 Token 后，立即退出当前的词法状态（BQHID），返回到进入该状态之前的状态（通常是 DEFAULT）。
    < HYPHENATED_IDENTIFIER: <LETTER> (<LETTER>|<DIGIT>|"-")* > { popState(); }
}

// <DEFAULT, BQID BTID, DQID,> 词法状态列表，表示这些 Token 定义在多种词法状态下都有效。
// DEFAULT: 标准 SQL 状态。
// DQID (Double Quoted ID): 双引号内部状态。
// BTID (Back Tick ID): 反引号内部状态。
// BQID (Big Query ID): BigQuery 风格的反引号状态。
// TOKEN: 告诉 JavaCC，接下来的定义如果匹配成功，将生成一个供语法分析器使用的 Token。
<DEFAULT, DQID, BTID, BQID> TOKEN :
{
    // 检查配置对象中是否定义了自定义的标识符规则。
    <#if parser.customIdentifierToken?has_content>
        ${parser.customIdentifierToken}
    // 默认标识符规则
    // 正则表达式等价于：[a-zA-Z][a-zA-Z0-9]*（具体取决于 <LETTER> 和 <DIGIT> 在该文件前面的宏定义，通常包含 Unicode 字符）
    <#else>
    // < ... >：表示这是一个词法单元（Token）定义。
    // IDENTIFIER：这是你给这个 Token 起的名字。在后续的语法解析（Parser）阶段，你可以直接引用这个名字。
    // :：分隔符，左边是名称，右边是具体的匹配规则。
        < IDENTIFIER: <LETTER> (<LETTER>|<DIGIT>)* >
    </#if>
}


<DEFAULT, DQID, BTID, BQID, BQHID> TOKEN :
{
    // 名为 COLLATION_ID 的 Token。它用于匹配 SQL 中特定的排序规则标识符（Collation Identifier）。
    < COLLATION_ID:
    // 前缀起手 必须以至少一个字母或数字开头
    // 中间扩展名 由字母、数字或特定的符号（冒号、点、中划线、下划线）组成的序列，可以是 0 个。
    // 核心分隔符与语言/属性 必须有一个美元符号 $，后面紧跟至少一个字母或下划线。
    // 可选的后缀  一个可选的分段。如果存在，必须以 $ 开头，后跟字母、数字或下划线。
    (<LETTER>|<DIGIT>)+ (<LETTER>|<DIGIT>|":"|"."|"-"|"_")*
    "$"
    (<LETTER>|"_")+
    ("$" (<LETTER>|<DIGIT>|"_")+)?
    >
|
   // 专门用于匹配 SQL 标准中支持 Unicode 转义序列 的引用标识符。
   // 它要求字符串以特定的前缀开头，后接一个带引号的标识符。
   // "U": 必须以大写字母 U 开头。
   // "&": 紧接着必须是一个 & 符号。
   // <QUOTED_IDENTIFIER>: 引用了之前定义的双引号标识符规则。这意味着它后面必须跟着一个用双引号括起来的字符串（例如 "..."）
    < UNICODE_QUOTED_IDENTIFIER: "U" "&" <QUOTED_IDENTIFIER> >
|
   // 私有词法状态宏（Private Lexical Token） 定义
   // 在 Token 名称前加上 # 符号，意味着这个规则不会直接生成一个独立的 Token 返回给语法解析器，而是作为一个“内部零件”，供其他的 TOKEN 定义（如 IDENTIFIER）引用。
   // < # ... >: # 表示私有（Private）。它像是一个正则表达式变量，只能在词法规则内部被引用。
   // [...]:字符集（Character Set）。表示只要匹配其中任何一个字符或范围，就符合规则。
    < #LETTER:
    [
        "\u0024", // 美元符号 $ (某些方言允许变量以 $ 开头)
        "\u0041"-"\u005a", // 英文大写字母 A-Z
        "\u005f", // 下划线 _
        "\u0061"-"\u007a",// 英文小写字母 a-z
        "\u00c0"-"\u00d6", // 带重音符号的拉丁字母（如 À, é, ö 等）
        "\u00d8"-"\u00f6", // 更多的扩展拉丁语、希腊语、西里尔字母等
        "\u00f8"-"\u00ff",
        "\u0100"-"\u1fff",
        "\u3040"-"\u318f",
        "\u3300"-"\u337f",
        "\u3400"-"\u3d2d",
        "\u4e00"-"\u9fff",  // CJK 统一汉字 (几乎涵盖了所有常用中文)
        "\uf900"-"\ufaff"  // CJK 兼容汉字
    ]
    >
|
    // 定义 DIGIT（数字） 宏的私有词法规则。
    // 定义哪些 Unicode 字符在 SQL 标识符中可以被视为“数字”。除了我们熟悉的阿拉伯数字 0-9，它还包含了大量非西方文明使用的数字符号。
    < #DIGIT:
    [
        "\u0030"-"\u0039", // 标准阿拉伯数字 (0-9)
        "\u0660"-"\u0669", // 阿拉伯-印度数字
        "\u06f0"-"\u06f9",
        "\u0966"-"\u096f",
        "\u09e6"-"\u09ef",
        "\u0a66"-"\u0a6f",
        "\u0ae6"-"\u0aef",
        "\u0b66"-"\u0b6f",
        "\u0be7"-"\u0bef",
        "\u0c66"-"\u0c6f",
        "\u0ce6"-"\u0cef",
        "\u0d66"-"\u0d6f",
        "\u0e50"-"\u0e59",
        "\u0ed0"-"\u0ed9",
        "\u1040"-"\u1049" // 缅甸数字
    ]
    >
}

/* Special token to throw a wrench in the works. It is never valid in SQL,
   and so when it occurs, it causes the parser to print which tokens would
   have been valid at that point. Used by SqlAdvisor. */
// 定义了一个名为 BEL 的特殊 Token，它在词法分析器中扮演着一个非常精妙的角色：人为制造报错以获取语法提示。
// 核心作用不是为了解析合法的 SQL，而是为了语法补全（IntelliSense/Auto-completion）功能服务的。
<DEFAULT, DQID, BTID, BQID, BQHID> TOKEN :
{
    < BEL:
    [
        // 是 ASCII 码中的“响铃”字符（Bell）。在现代文本中它几乎是不可见且不可打印的，更不会出现在任何合法的 SQL 语句中
        "\u0007"
    ]
    >
}

/**
 * Defines a production which can never be accepted by the parser.
 * In effect, it tells the parser, "If you got here, you've gone too far."
 * It is used as the default production for parser extension points;
 * derived parsers replace it with a real production when they want to
 * implement a particular extension point.
 */
void UnusedExtension() :
{
}
{
    (
        LOOKAHEAD({false}) <ZONE>
    )
}
