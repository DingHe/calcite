    |   <MAX>
    |   <MIN>
    |   <MINUTE>
    |   <MOD>
    |   <MONTH>
    |   <NTH_VALUE>
    |   <NTILE>
    |   <NULLIF>
    |   <OCTET_LENGTH>
    |   <PERCENTILE_CONT>
    |   <PERCENTILE_DISC>
    |   <PERCENT_RANK>
    |   <POWER>
